{
  "name": "typesetter",
  "version": "1.0.0",
  "description": "TeX-grade web typesetting engine: C++/WASM core + JS runtime (.tsm markup)",
  "scripts": {
    "test": "npm run test:engine && npm run corpus && npm run e2e",
    "test:engine": "ctest --test-dir engine/build",
    "record": "node tools/record-fixtures.mjs",
    "e2e": "playwright test",
    "corpus": "node tools/corpus-run.mjs",
    "bench:edit": "node tools/bench-edit.mjs",
    "hl-assets": "node tools/codehl-assets.mjs",
    "pack": "node tools/pack-dist.mjs"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "hyphen": "^1.14.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cli": "^0.25.10",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.13"
  },
  "private": true
}
