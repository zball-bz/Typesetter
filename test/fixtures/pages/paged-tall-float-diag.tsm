#{
  // (plan P5-02) a top float taller than a sheet: a sheet of its own,
  // overflowing visibly with a warning; the flow goes on after it
  $.set({role: 'topnote'}, {place: {float: 'top'}, box: {border: '1px', padding: '0.2em'}})
}

