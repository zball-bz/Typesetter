#{
  // a hanging-indent reference list (plan P3-14): par.hang is inherited, so
  // the bibliography's entries hang their turnover lines 2em in
  $.set({role: 'bibliography'}, {par: {hang: '2em', indent: '0'}})
}
#let refs = $.collector('refs', {like: 'bibliography'})

