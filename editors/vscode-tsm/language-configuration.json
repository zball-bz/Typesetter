{
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "$", "close": "$", "notIn": ["string"] },
    { "open": "%--", "close": "--%" }
  ],
  "surroundingPairs": [
    ["(", ")"], ["[", "]"], ["{", "}"],
    ["`", "`"], ["$", "$"], ["*", "*"], ["_", "_"]
  ],
  "folding": {
    "markers": {
      "start": "^#![A-Za-z_]",
      "end": "^#[A-Za-z_][A-Za-z0-9_]*!"
    }
  }
}
