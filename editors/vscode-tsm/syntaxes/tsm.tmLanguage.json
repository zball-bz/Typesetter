{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typesetter Markup",
  "scopeName": "source.tsm",
  "comment": "GENERATED by tools/gen-grammars.mjs from the engine's syntax table (syntax version 4) — do not edit. Coarse first-paint grammar: precise coloring comes from the engine (semantic tokens, tsr_syntax_tokens).",
  "patterns": [
    {
      "include": "#block-comment"
    },
    {
      "include": "#fence-cpp-literate"
    },
    {
      "include": "#fence-json"
    },
    {
      "include": "#fence-javascript"
    },
    {
      "include": "#fence-typescript"
    },
    {
      "include": "#fence-python"
    },
    {
      "include": "#fence-cpp"
    },
    {
      "include": "#fence-rust"
    },
    {
      "include": "#fence-tsm"
    },
    {
      "include": "#fence"
    },
    {
      "include": "#heading"
    },
    {
      "include": "#region"
    },
    {
      "include": "#code-statement"
    },
    {
      "include": "#code-block"
    },
    {
      "include": "#rule"
    },
    {
      "include": "#inline"
    }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.tsm",
      "begin": "%--",
      "end": "--%"
    },
    "fence": {
      "name": "markup.raw.block.tsm",
      "begin": "^(`{3,})([^\\n]*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      }
    },
    "heading": {
      "name": "markup.heading.tsm",
      "match": "^(={1,6}) .*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.tsm"
        }
      }
    },
    "region": {
      "match": "^(#![A-Za-z_][A-Za-z0-9_]*|#[A-Za-z_][A-Za-z0-9_]*!)(\\([^\\n]*\\))?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.region.tsm"
        },
        "2": {
          "name": "meta.function-call.arguments.tsm"
        }
      }
    },
    "code-statement": {
      "name": "keyword.control.let.tsm",
      "match": "^#let [^\\n]*$"
    },
    "code-block": {
      "patterns": [
        {
          "name": "meta.embedded.block.javascript",
          "match": "^#\\{.*\\}\\s*$"
        },
        {
          "begin": "^(#\\{)(?!.*\\}\\s*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.begin.tsm"
            }
          },
          "end": "^(\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.embedded.end.tsm"
            }
          },
          "contentName": "meta.embedded.block.javascript",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        }
      ]
    },
    "rule": {
      "name": "meta.separator.tsm",
      "match": "^-{3,}[ \\t]*$"
    },
    "inline": {
      "patterns": [
        {
          "name": "markup.inline.raw.tsm",
          "match": "`[^`\\n]*`"
        },
        {
          "name": "string.other.math.tsm",
          "match": "\\$[^\\$\\n]*\\$"
        },
        {
          "name": "markup.bold.tsm",
          "match": "\\*[^\\*\\n]+\\*"
        },
        {
          "name": "markup.italic.tsm",
          "match": "_[^_\\n]+_"
        },
        {
          "match": "(\\[[^\\]\\n]*\\])(\\([^)\\n]*\\))",
          "captures": {
            "1": {
              "name": "string.other.link.title.tsm"
            },
            "2": {
              "name": "markup.underline.link.tsm"
            }
          }
        },
        {
          "name": "constant.other.reference.tsm",
          "match": "@([A-Za-z_$][A-Za-z0-9_$-]*|\\[[^\\]\\n]+\\])"
        },
        {
          "name": "entity.name.label.tsm",
          "match": "<[A-Za-z_][A-Za-z0-9_-]*>"
        },
        {
          "name": "keyword.control.flow.tsm",
          "match": "#(if|for|while)(?!\\w)"
        },
        {
          "name": "keyword.control.flow.tsm",
          "match": "(?<=\\]|\\] )else\\b"
        },
        {
          "name": "entity.name.function.splice.tsm",
          "match": "#(\\(|[A-Za-z_$][A-Za-z0-9_$.]*)"
        }
      ]
    },
    "fence-cpp-literate": {
      "begin": "^(`{3,})\\s*(?i:(cpp-literate))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.cpp meta.overlay.noweb.tsm",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "fence-json": {
      "begin": "^(`{3,})\\s*(?i:(json))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "fence-javascript": {
      "begin": "^(`{3,})\\s*(?i:(javascript|js|mjs))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "fence-typescript": {
      "begin": "^(`{3,})\\s*(?i:(typescript|ts))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    "fence-python": {
      "begin": "^(`{3,})\\s*(?i:(python|py))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.python",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "fence-cpp": {
      "begin": "^(`{3,})\\s*(?i:(cpp|c\\+\\+|cc|c))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.cpp",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "fence-rust": {
      "begin": "^(`{3,})\\s*(?i:(rust|rs))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "fence-tsm": {
      "begin": "^(`{3,})\\s*(?i:(tsm))(?![\\w+#.-])[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        },
        "2": {
          "name": "fenced_code.block.language.tsm"
        }
      },
      "end": "^(\\1)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.tsm"
        }
      },
      "contentName": "meta.embedded.block.tsm",
      "patterns": [
        {
          "include": "source.tsm"
        }
      ]
    }
  }
}
