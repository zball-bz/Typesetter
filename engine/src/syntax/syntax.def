// The surface language's lexical and structural facts (plan P1-05; design
// T1 SyntaxTable) — the single source tools/gen-syntax.mjs reads to generate
// engine/src/syntax/syntax.gen.{h,cc}, runtime/src/shared/syntax.gen.{json,mjs}
// and docs/syntax-table.md. Rows are data; behaviour (body modes, ownership,
// block shapes) is a closed set implemented in code. Never hand-edit the
// generated files.
SYNTAX_VERSION(6)

// ---- character classes ----------------------------------------------------
CLASS(SpliceHead, "A-Za-z_$")
CLASS(SpliceCont, "A-Za-z0-9_$")
CLASS(IdStart, "A-Za-z_")
CLASS(IdCont, "A-Za-z0-9_")
CLASS(IdJoin, "-.:")
// labels (` <id>`, `@[…]`; plan P2-06): any character but whitespace and
// the label syntax's own (Unicode whitespace is excluded by the lexer)
CLASS(LabelChar, "^ <>[]@,;\\")
// a backslash before one of these is that character; before the end of a
// line a hard line break; before anything else a backslash (plan P3-33)
CLASS(Escapable, "!-/:-@[-`{-~")

// ---- inline delimiters: id, open, close, body mode, params, guard, prec, slot, capture
// Guards (plan P3-33): PrevIdent — a '#' bare value head (no '(' or '['
// after it) and '@' are text right after [A-Za-z0-9_$] (word#todo,
// user@host); Intraword — '*' and '_' are text between two ASCII letters or
// digits (snake_case, 2*3*4). A leading placeholder is the lexer's to check
// behind the literal opener: url's SCHEME (http, https) precedes "://".
INLINE(code,    "`",       "`",        Verbatim,  "pad=Strip",            "-",         Island,  code,      "string")
INLINE(math,    "$",       "$",        Verbatim,  "esc=$ pad=Display",    "-",         Island,  math,      "embedded")
INLINE(comment, "%--",     "--%",      Verbatim,  "nest",                 "-",         Comment, comment,   "comment")
INLINE(url,     "SCHEME://", "URL_END", Verbatim, "-",                    "-",         Island,  link,      "link")
INLINE(splice,  "#HEAD",   "HEAD_CHAIN", CallChain, "-",                  "PrevIdent", Markup,  splice,    "function")
INLINE(strong,  "*",       "*",        Pair,      "-",                    "Intraword", Markup,  strong,    "strong")
INLINE(em,      "_",       "_",        Pair,      "-",                    "Intraword", Markup,  em,        "emphasis")
INLINE(link,    "[",       "](URL)",   LinkText,  "-",                    "-",         Markup,  link,      "link")
INLINE(note,    "^[",      "]",        Content,   "-",                    "-",         Markup,  note,      "note")
INLINE(ref,     "@",       "BARE_ID",  Ident,     "-",                    "PrevIdent", Markup,  ref,       "label")
INLINE(refs,    "@[",      "]",        IdList,    "-",                    "-",         Markup,  ref,       "label")
INLINE(brk,     "\\EOL",   "-",        -,         "-",                    "-",         Markup,  linebreak, "punctuation")

// ---- blocks: id, shape, starter, interrupts, ownership, slot ---------------
BLOCK(quote,   Prefix,   "> ",                  Always,    None,      quote)
BLOCK(item,    Column,   "LIST_MARKER",         ListRule,  None,      item)
// (plan P3-34; D-L08) a description item: its term up to the first `:` with a
// blank or the line's end after it (outside atoms); consecutive ones at one
// column are one description list (terms)
BLOCK(term,    Column,   "/ TERM: ",            ListRule,  None,      terms)
BLOCK(region,  Explicit, "#!NAME ARGS?",        Always,    Container, region)
BLOCK(fence,   Verbatim, "``` INFO",            Always,    Container, fence)
BLOCK(comment, Verbatim, "%--",                 LeafOwned, Container, comment)
BLOCK(heading, Leaf,     "={1,6} TEXT <label>?", Always,   None,      heading)
BLOCK(rule,    Leaf,     "---",                 Always,    None,      rule)
BLOCK(let,     Stmt,     "#let ",               Always,    Container, -)
BLOCK(stmt,    Stmt,     "#{",                  Always,    Container, -)
BLOCK(para,    Leaf,     "DEFAULT",             -,         None,      para)

// ---- keyword forms (P2-12) and words a splice head may not be -------------
KEYWORD(if, elseChain)
KEYWORD(for)
KEYWORD(while)
RESERVED_UNSUPPORTED(if, else, for, while, let)
RESERVED(break, case, catch, class, const, continue, debugger, default, delete, do, export, extends, finally, function, import, in, instanceof, new, return, switch, throw, try, typeof, var, void, with, yield, static, enum, await)

// ---- highlight token tags (shared by the engine fold, the token providers
// and the editor grammars) -------------------------------------------------
TOKEN_TAGS(keyword, string, number, comment, function, type, constant, variable, operator, punctuation, property, attribute, label, embedded)

// ---- sugar: slot, form, typed payload, dump format --------------------------
// Payload fields: name:type, type ∈ u8 | bool | i32 | u32 | str (an interned
// string) | src (a source span, printed as its text). The node's own `str` is
// $str. Dump templates: {field} prints a value, "…{field}…" an escaped
// string, {?field …} prints its body only when the field is set,
// {field?yes:no} picks by a boolean. Legacy formats keep today's dump bytes.
SUGAR(para,    Block,  "",                                  "para")
SUGAR(heading, Block,  "level:u8 label:str",                "heading level={level}{?label label=\"{label}\"}")
SUGAR(list,    Block,  "ordered:bool start:i32",            "list {ordered?ordered:bullet} start={start}")
SUGAR(item,    Block,  "",                                  "item")
SUGAR(terms,   Block,  "",                                  "terms")
SUGAR(termpart, Inline, "",                                 "term")
SUGAR(quote,   Block,  "",                                  "quote")
SUGAR(rule,    Block,  "",                                  "rule")
SUGAR(fence,   Block,  "lang:str args:src bodyOffset:u32 bodyEnd:u32 lines:str info:str? label:str?", "codeblock lang=\"{lang}\"{?info info=\"{info}\"}{?label label=\"{label}\"} body=\"{$str}\"")
SUGAR(region,  Block,  "args:src label:str?",                "region name=\"{$str}\"{?label label=\"{label}\"}")
SUGAR(strong,  Inline, "",                                  "styled marker=*")
SUGAR(em,      Inline, "",                                  "styled marker=_")
SUGAR(code,    Inline, "",                                  "code str=\"{$str}\"")
SUGAR(link,    Inline, "url:str",                           "link url=\"{url}\"")
SUGAR(note,    Inline, "",                                  "note")
SUGAR(ref,     Inline, "",                                  "ref target=\"{$str}\"")
SUGAR(linebreak, Inline, "",                                "linebreak")
SUGAR(math,    Both,   "display:bool label:str",            "math display={display} src=\"{$str}\"{?label label=\"{label}\"}")
// legacy shapes until P2-11 (region provenance) / P2-13 (splice bodies)
SUGAR(arg,     Inline, "",                                  "arg")

// non-sugar node payloads (Splice, Stmt, Error)
NODE(Splice, "expr:str lastCall:u32 named:bool?",           "splice expr=\"{expr}\"{named? named:}")
// js: the statement's JavaScript, its lines with their container prefixes
// stripped (a content literal `#let x = [ … ]`: its name; kids: its body)
NODE(Stmt,   "let:bool js:str content:bool?",               "{let?code-let:code-block} js=\"{js}\"{content? content:}")
NODE(Error,  "message:str",                                 "error code=\"{$str}\" msg=\"{message}\"")
NODE(Text,   "rawmap:str? seps:str?",                       "text str=\"{$str}\"")
// a comment block; front: the document's front matter (plan P3-35, a host option)
NODE(Comment, "front:bool?",                                "comment body=\"{$str}\"{front? front:}")
// a keyword form (plan P2-12): $str = the keyword; kids = its Branch nodes
NODE(Keyword, "",                                           "keyword {$str}")
// a branch of a keyword form: its head JS (a condition, a for/while head;
// empty: else) and, as kids, its body
NODE(Branch, "head:src",                                    "branch head=\"{head}\"")
NODE(Doc,    "",                                            "doc")
