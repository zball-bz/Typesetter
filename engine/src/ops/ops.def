// Single source of truth for the ops contract (document-model.md §4).
// Consumed by: engine/src/ops/ops.h (X-macro), tools/gen-ops-ts.mjs (regex).
// Changing any number is a protocol version bump: update OPS_VERSION.
//
// OPS_VERSION(2)

OP(MAKE_TEXT, 1)
OP(MAKE_NODE, 2)
OP(EMIT, 3)
OP(STYLE_PUSH, 4)
OP(STYLE_POP_TO, 5)
OP(SPAN, 6)

KIND(doc, 0)
KIND(para, 1)
KIND(heading, 2)
KIND(list, 3)
KIND(item, 4)
KIND(quote, 5)
KIND(codeblock, 6)
KIND(rule, 7)
KIND(group, 8)
KIND(table, 9)
KIND(trow, 10)
KIND(tcell, 11)
KIND(term, 12)
KIND(collect, 13)
KIND(mathblock, 14)
KIND(error, 15)
KIND(comment, 16)
KIND(text, 17)
KIND(styled, 18)
KIND(link, 19)
KIND(code, 20)
KIND(ref, 21)
KIND(mathinline, 22)
KIND(raw, 23)
KIND(hardbreak, 24)
KIND(seq, 25)

ARGK(label, 0)
ARGK(level, 1)
ARGK(ordered, 2)
ARGK(start, 3)
ARGK(lang, 4)
ARGK(body, 5)
ARGK(role, 6)
ARGK(cols, 7)
ARGK(align, 8)
ARGK(name, 9)
ARGK(what, 10)
ARGK(src, 11)
ARGK(message, 12)
ARGK(code, 13)
ARGK(url, 14)
ARGK(target, 15)
ARGK(form, 16)
ARGK(html, 17)
ARGK(w, 18)
ARGK(h, 19)
ARGK(bits, 20)
ARGK(font, 21)
ARGK(color, 22)
ARGK(sizePx, 23)
// style patches reuse ARGK(lang, 4): codeblock's language tag and the
// InlineStyle BCP-47 tag are per-kind namespaces over one key
