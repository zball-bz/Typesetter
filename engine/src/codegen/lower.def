// The LowerProgram format (plan P2-02; design T2 S5; docs/lowering-design.md)
// — the one source of its opcodes, constant tags, block kinds and flags.
// tools/gen-lower.mjs generates engine/src/codegen/lower.gen.h (codegen, the
// reader/validator, the fuzz target) and runtime/src/shared/lower.gen.mjs
// (lower.mjs, the interpreter). PROGRAM_ABI is a hash of this file: every
// program and every hole module carries it, tsr2_abi reports it, and the
// runtime refuses a program or module of another ABI. Vocabulary (schema.json)
// is not part of it — the schemaHash handshake covers that, so a new
// constructor never touches a program or a hole module.
//
// LOWER_VERSION: the program's binary layout; LOWER_PROTOCOL: the hole-module
// calling convention (__rt.std, __rt.run(__h, segment), __rt.syntax(block),
// a hole is h[i](__k) with __k() its content arguments; SCOPE and LOOP
// holes h[i](__b), LET holes h[i](value): plan P2-12).
LOWER_VERSION(1)
LOWER_PROTOCOL(2)

// LOP(name, code, operands) — body ops, preorder. The high bit of the op
// byte (0x80) marks a subtree that awaits (a fence, a region — their
// handlers may be async —, an async hole).
LOP(TEXT,     1, "str s e nMap (cooked raw)* nSep sep*")   // raw relative to s (plan P2-04);
                                                          // sep: a cell cut's cooked offset (plan P2-11)
LOP(CALL,     2, "flags ctor [s e] nAttrs (key const)* nKids value*")
LOP(HOLE,     3, "hole s e nKids value*")
LOP(FRAME,    4, "s e holeLo holeHi value")
LOP(FENCE,    5, "lang args label+1 info+1 body bodyOffset bodyEnd lines:const s e")
LOP(REGION,   6, "name args label+1 s e nItems value*")
LOP(STMT,     8, "hole")                                  // its value: nothing
LOP(VERBATIM, 9, "ordinal")
// args (FENCE, REGION): 0 = none, else (hole + 1) << 1 | 1 when that hole
// awaits. VERBATIM's ordinal k: the k-th verbatim block, piece holes + k;
// the module runs segment k up to it.
// Keyword forms and statements anywhere (plan P2-12):
LOP(IF,       10, "nBranch (cond+1 value)*")   // cond 0: else; no branch taken: nothing
LOP(SCOPE,    11, "hole nHoles value")         // a body with its own #let names
LOP(LOOP,     12, "hole nHoles s e value")     // #for / #while: the body per iteration
LOP(LET,      13, "hole value")                // #let x = [ … ]: its value: nothing
// SCOPE and LOOP: the hole is h(__b) (the scope or the loop, in JS), and
// __b(table) evaluates the value against `table`: a hole table of its own
// (nHoles holes, numbered from 0), whose functions close over the scope's
// names. LET's hole is h(v): it binds the name to the value.

// CONST(name, tag) — a literal value (attrs, fence lines)
CONST(Null,  0)
CONST(False, 1)
CONST(True,  2)
CONST(Uint,  3)
CONST(F64,   4)
CONST(Str,   5)
CONST(Array, 6)

// BLOCK(name, code) — a top-level block's kind in the block table
BLOCK(Content,  0)
BLOCK(Stmt,     1)
BLOCK(Verbatim, 2)

// BFLAG(name, bit) — a top-level block's flags
BFLAG(User,   1)   // runs user code: diagnostics of the run point at it
BFLAG(Framed, 2)   // an error inside becomes an error block at its span
BFLAG(Async,  4)   // its value awaits

// PIECE(name, code) — a stretch of user code in the hole module (D-I11)
PIECE(Hole,     0)
PIECE(Verbatim, 1)

// CALL flags
CFLAG(Spanned, 1)
