{
  "$comment": [
    "Single source of truth for the ops contract (plan P0-06; design T2 S1).",
    "tools/gen-schema.mjs generates engine/src/ops/ops.def (X-macro), engine/src/ops/schema.gen.{h,cc},",
    "runtime/src/shared/ops.gen.mjs and docs/schema-table.md. Ids and since values are immutable and",
    "mirrored in schema.lock.json. A change of meaning or encoding of an existing row needs a",
    "MIN_COMPAT bump; new vocabulary takes the next since (plan MD-03).",
    "Domains: bool | int:LO:HI | num:LO:HI | str | token (may be empty) | ident | label | lang |",
    "  enum:A|B|C | flags:NAME=BIT,... | rangeset | color | font | html | url.",
    "Attribute order is the writer's order (today's constructor argument order)."
  ],
  "opsVersion": 6,
  "minCompat": 6,
  "ops": {
    "MAKE_TEXT": {"id": 1, "since": 6},
    "MAKE_NODE": {"id": 2, "since": 6},
    "EMIT": {"id": 3, "since": 6},
    "STYLE_PUSH": {"id": 4, "since": 6},
    "STYLE_POP_TO": {"id": 5, "since": 6},
    "SPAN": {"id": 6, "since": 6}
  },
  "keys": {
    "label": 0, "level": 1, "ordered": 2, "start": 3, "lang": 4, "body": 5, "role": 6, "cols": 7,
    "align": 8, "name": 9, "what": 10, "src": 11, "message": 12, "code": 13, "url": 14,
    "target": 15, "form": 16, "html": 17, "w": 18, "h": 19, "bits": 20, "font": 21, "color": 22,
    "sizePx": 23, "wrap": 24, "lineNo": 25, "hl": 26, "sidecar": 27, "scale": 28, "alt": 29,
    "side": 30
  },
  "kinds": {
    "doc": {"id": 0, "level": "block", "body": "blocks", "since": 6, "attrs": {}},
    "para": {"id": 1, "level": "block", "body": "inline", "since": 6, "attrs": {}},
    "heading": {"id": 2, "level": "block", "body": "inline", "since": 6, "attrs": {
      "level": {"dom": "int:1:6", "def": 1},
      "label": {"dom": "label"}}},
    "list": {"id": 3, "level": "block", "body": "items", "since": 6, "attrs": {
      "ordered": {"dom": "bool", "def": false},
      "start": {"dom": "int:-1073741824:1073741824", "def": 1}}},
    "item": {"id": 4, "level": "block", "body": "blocks", "since": 6, "attrs": {}},
    "quote": {"id": 5, "level": "block", "body": "blocks", "since": 6, "attrs": {}},
    "codeblock": {"id": 6, "level": "block", "body": "code", "since": 6, "attrs": {
      "lang": {"dom": "token"},
      "wrap": {"dom": "bool"},
      "lineNo": {"dom": "int:0:1048576", "coerce": "boolAsInt"},
      "hl": {"dom": "rangeset"},
      "sidecar": {"dom": "str"}}},
    "rule": {"id": 7, "level": "block", "body": "none", "since": 6, "attrs": {}},
    "group": {"id": 8, "level": "adaptive", "body": "position", "since": 6, "attrs": {
      "role": {"dom": "ident"},
      "label": {"dom": "label"},
      "name": {"dom": "str"}}},
    "table": {"id": 9, "level": "block", "body": "rows", "since": 6, "attrs": {
      "cols": {"dom": "int:1:64"},
      "align": {"dom": "token"},
      "label": {"dom": "label"}}},
    "trow": {"id": 10, "level": "block", "body": "cells", "since": 6, "attrs": {}},
    "tcell": {"id": 11, "level": "block", "body": "inline", "since": 6, "attrs": {}},
    "term": {"id": 12, "level": "adaptive", "body": "inline", "since": 6, "attrs": {
      "name": {"dom": "str"}}},
    "collect": {"id": 13, "level": "block", "body": "data", "since": 6, "attrs": {
      "what": {"dom": "enum:toc|glossary|notes|bibliography"},
      "form": {"dom": "enum:all"}}},
    "mathblock": {"id": 14, "level": "block", "body": "none", "since": 6, "attrs": {
      "src": {"dom": "str"},
      "label": {"dom": "label"}}},
    "error": {"id": 15, "level": "adaptive", "body": "none", "since": 6, "attrs": {
      "message": {"dom": "str"},
      "code": {"dom": "ident"}}},
    "comment": {"id": 16, "level": "trivia", "body": "text", "since": 6, "attrs": {}},
    "text": {"id": 17, "level": "inline", "body": "none", "since": 6, "attrs": {}},
    "styled": {"id": 18, "level": "transparent", "body": "position", "since": 6, "attrs": {
      "bits": {"dom": "flags:EM=2,BOLD=3,UNDER=16,OVER=17,STRIKE=18", "def": 0},
      "font": {"dom": "font"},
      "lang": {"dom": "lang"},
      "color": {"dom": "color"},
      "sizePx": {"dom": "num:1:2000"}}},
    "link": {"id": 19, "level": "inline", "body": "inline", "since": 6, "attrs": {
      "url": {"dom": "url"}}},
    "code": {"id": 20, "level": "inline", "body": "text", "since": 6, "attrs": {}},
    "ref": {"id": 21, "level": "inline", "body": "none", "since": 6, "attrs": {
      "target": {"dom": "str"}}},
    "mathinline": {"id": 22, "level": "inline", "body": "none", "since": 6, "attrs": {
      "src": {"dom": "str"}}},
    "raw": {"id": 23, "level": "block", "body": "none", "since": 6, "attrs": {
      "html": {"dom": "html"},
      "w": {"dom": "num:0:100000"},
      "h": {"dom": "num:0:100000"}}},
    "hardbreak": {"id": 24, "level": "inline", "body": "none", "since": 6, "attrs": {}},
    "seq": {"id": 25, "level": "transparent", "body": "position", "since": 6, "attrs": {}},
    "image": {"id": 26, "level": "block", "body": "none", "since": 6, "attrs": {
      "src": {"dom": "url"},
      "alt": {"dom": "str"},
      "w": {"dom": "num:0:100000"},
      "h": {"dom": "num:0:100000"},
      "scale": {"dom": "num:0:100"},
      "side": {"dom": "enum:left|right"}}},
    "note": {"id": 27, "level": "inline", "body": "blocks", "since": 6, "attrs": {}}
  },
  "domains": {
    "$comment": [
      "Textual value domains (plan P1-02): a byte-level regular expression (whole-string match) and a",
      "maximum UTF-8 length (0 = none). tools/gen-schema.mjs compiles each to a DFA for C++ (the ops",
      "reader's authoritative check) and to a RegExp for JS; \\x80-\\xff means any non-ASCII character."
    ],
    "ident": {
      "max": 64,
      "re": "[A-Za-z_][A-Za-z0-9_\\-]*"
    },
    "label": {
      "max": 512,
      "re": "[^\\x00-\\x1f\\x7f]+"
    },
    "lang": {
      "max": 64,
      "re": "[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*"
    },
    "rangeset": {
      "max": 0,
      "re": " *[0-9]{1,7} *(- *[0-9]{1,7} *)?(, *[0-9]{1,7} *(- *[0-9]{1,7} *)?)*"
    },
    "color": {
      "max": 64,
      "re": "#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})|var\\(--[A-Za-z0-9_\\-]+\\)|(rgb|rgba|hsl|hsla)\\([0-9.,/ %deg\\-]*\\)|[A-Za-z]+"
    },
    "font": {
      "max": 512,
      "re": " *(\"[^\"'\\\\\\x00-\\x1f\\x7f]+\" *|'[^\"'\\\\\\x00-\\x1f\\x7f]+' *|[A-Za-z0-9_\\-\\x80-\\xff][A-Za-z0-9 _\\-\\x80-\\xff]*)(, *(\"[^\"'\\\\\\x00-\\x1f\\x7f]+\" *|'[^\"'\\\\\\x00-\\x1f\\x7f]+' *|[A-Za-z0-9_\\-\\x80-\\xff][A-Za-z0-9 _\\-\\x80-\\xff]*))*"
    }
  },
  "props": {
    "$comment": [
      "Run properties (plan P1-02; design T4 M2): one row per Styling field, in field order.",
      "type: bits (a flag set, ORed) | mul (size multiplier, composed by the engine) | str (an interned string) | px (absolute px).",
      "attr: the styled/STYLE_PUSH attribute that patches it (domain: that attribute's); sugar: boolean $.style.push keys setting one flag;",
      "dump: the label in the tree/block dumps; html: an attribute the typeset serializer writes;",
      "css + cssOrder: the declaration it writes (cssFlags: flag → keyword list; cssValue emPx: the run's em in px)."
    ],
    "text.bits": {
      "field": "bits",
      "type": "bits",
      "attr": "bits",
      "sugar": {
        "bold": "BOLD",
        "italic": "EM",
        "underline": "UNDER",
        "overline": "OVER",
        "strike": "STRIKE"
      },
      "css": "text-decoration",
      "cssOrder": 4,
      "cssFlags": {
        "UNDER": "underline",
        "OVER": "overline",
        "STRIKE": "line-through"
      }
    },
    "text.sizeMul": {
      "field": "sizeMul",
      "type": "mul"
    },
    "text.font": {
      "field": "fontFamily",
      "type": "str",
      "attr": "font",
      "dump": {
        "label": "font",
        "quoted": true
      },
      "css": "font-family",
      "cssOrder": 2
    },
    "text.lang": {
      "field": "lang",
      "type": "str",
      "attr": "lang",
      "dump": {
        "label": "lang"
      },
      "html": "lang"
    },
    "text.color": {
      "field": "color",
      "type": "str",
      "attr": "color",
      "dump": {
        "label": "color"
      },
      "css": "color",
      "cssOrder": 3
    },
    "text.size": {
      "field": "sizePx",
      "type": "px",
      "attr": "sizePx",
      "dump": {
        "label": "size"
      },
      "css": "font-size",
      "cssOrder": 1,
      "cssValue": "emPx"
    }
  }
}
