  "policy": {
    "$comment": [
      "Host policy (plan P1-03; design T9 A4): how hosts drive the engine, not what it typesets.",
      "Not a document setting: createEngine({policy}) and the native driver read it."
    ],
    "maxRounds": {
      "def": 64,
      "doc": "pull-loop rounds before a typeset is declared stalled"
    },
    "fontDeadlineMs": {
      "def": 4000,
      "doc": "declared fonts measure as their fallback after this"
    },
    "fontRetryMs": {
      "def": 30000,
      "doc": "a failed font load is retried after this"
    },
    "grammarRetryMs": {
      "def": 30000,
      "doc": "a failed highlight grammar load is retried after this"
    },
    "imageTimeoutMs": {
      "def": 15000,
      "doc": "main-thread image size fallback timeout"
    },
    "tokenCacheEntries": {
      "def": 400,
      "doc": "worker token cache capacity"
    },
    "measureCacheWords": {
      "def": 200000,
      "doc": "measurer word cache capacity"
    },
    "nativeImagePx": {
      "def": [
        512,
        384
      ],
      "doc": "the native/golden image provider's answer"
    }
