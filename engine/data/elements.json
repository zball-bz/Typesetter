{
  "$comment": [
    "Built-in element rows (plan P1-10; design T3 Element registry), written in the form a document or host will use to declare its own (P2-07).",
    "counters: flat or by-level automata. classes: what a node is (select), how it is numbered, labelled, referenced, titled and what is attached to it (sites); flows lift items into a collector; tables hold keyed rows.",
    "collectors: the #toc / #glossary / #notes / #bibliography presets — a query plus wrap / entry / empty templates; a keyed table's rows are the instances of the classes that name it (bibentry: the entry rows #bibliography emits), cited ones in citation order, then (cited-then-all, or a collect node's cited) every other.",
    "Templates are generated, style-neutral content: strings and term/slot items concatenate into one text; node items build nodes through the cascade (plan P3-01: inline kinds are made at the site, their role selecting the default rules — caption-label, term-name, fn-marker, note-body —, block kinds style 0 unless style:site); styled items are deltas applied to everything inside, inserted content included ({weight, italic, decoration, role, baseline, size}: plan P2-08); a paras item lifts a flow item's body under an inline wrapper of its role.",
    "Words come from the locale packs (engine/data/locale) through term items; docs/semantics-design.md has the full reference."
  ],
  "counters": {
    "heading": { "shape": "by-level", "level-arg": "level", "depth": 6, "gap": "zero" },
    "table": {},
    "figure": {},
    "subfigure": { "within": { "counter": "figure", "depth": 1, "sep": "" }, "pattern": "(a)" },
    "equation": {},
    "footnote": {},
    "cite": { "keyed": true }
  },
  "roles": {
    "$comment": "Generated roles and the element each reads as on the semantic page (plan P3-01; T7's minimal map). Their presentation is the default rules' (engine/data/defaults.json).",
    "fn-marker": { "html": "sup" },
    "caption-label": { "html": "strong" },
    "term-name": { "html": "strong" }
  },
  "unresolved": [{ "term": "unresolved" }],
  "unnumbered": [{ "slot": "label" }],
  "classes": {
    "heading": {
      "select": [{ "node": "heading" }],
      "counter": "heading",
      "numbering": "always",
      "title": "text",
      "outline": true,
      "supplement": "section",
      "alias": { "prefix": "h-", "body": "number" },
      "ref": [{ "when": "extra", "kids": [{ "slot": "extra" }, " "], "else": [{ "slot": "supplement" }] }, { "slot": "number" }]
    },
    "table": {
      "select": [{ "node": "table" }],
      "counter": "table",
      "numbering": "always",
      "supplement": "table",
      "ref": [{ "when": "extra", "kids": [{ "slot": "extra" }, " "], "else": [{ "slot": "supplement" }] }, { "slot": "number" }]
    },
    "figure": {
      "select": [{ "node": "group", "role": "figure" }],
      "box": "figure",
      "html": "figure",
      "counter": "figure",
      "numbering": "always",
      "supplement": "figure",
      "sites": [
        {
          "where": "prepend",
          "at": "caption",
          "template": [
            { "node": "styled", "args": { "role": "caption-label" }, "kids": [{ "slot": "supplement" }, { "slot": "number" }, { "term": "caption-sep" }] }
          ]
        }
      ],
      "ref": [{ "when": "extra", "kids": [{ "slot": "extra" }, " "], "else": [{ "slot": "supplement" }] }, { "slot": "number" }]
    },
    "table-figure": {
      "$comment": "A figure whose body is one table (D-S01: the figure constructor sets kind table, or kind: says so) numbers as a table.",
      "select": [{ "node": "group", "role": "figure", "kind": "table" }],
      "like": "figure",
      "counter": "table",
      "supplement": "table"
    },
    "subfigure": {
      "$comment": "A figure inside a figure (D-S02): numbered within it, (a); referenced as 图 1(a).",
      "select": [{ "node": "group", "role": "figure", "inside": "figure" }, { "node": "group", "role": "figure", "inside": "table-figure" }],
      "like": "figure",
      "counter": "subfigure",
      "sites": [
        {
          "where": "prepend",
          "at": "caption",
          "template": [{ "node": "styled", "args": { "role": "caption-label" }, "kids": [{ "slot": "number" }, " "] }]
        }
      ]
    },
    "figure-table": {
      "$comment": "A table inside a figure: unnumbered, and a label on it names the figure (refers-to enclosing; Typst's table in figure).",
      "select": [{ "node": "table", "inside": "figure" }, { "node": "table", "inside": "table-figure" }, { "node": "table", "inside": "subfigure" }],
      "like": "table",
      "numbering": "never",
      "refers-to": "enclosing"
    },
    "equation": {
      "select": [{ "node": "mathblock" }],
      "counter": "equation",
      "numbering": "labelled",
      "supplement": "equation",
      "sites": [
        { "where": "arg", "arg": "name", "template": ["(", { "slot": "number" }, ")"] },
        { "where": "tag", "template": ["(", { "slot": "number" }, ")"] }
      ],
      "ref": [{ "when": "extra", "kids": [{ "slot": "extra" }, " "], "else": [{ "slot": "supplement" }] }, "(", { "slot": "number" }, ")"]
    },
    "footnote": {
      "select": [{ "node": "note" }],
      "counter": "footnote",
      "numbering": "always",
      "labels": "none",
      "alias": { "prefix": "fn-", "body": "number" },
      "ref": [{ "slot": "number" }],
      "flow": {
        "name": "notes",
        "placement": "end",
        "marker-alias": { "prefix": "fnref-", "body": "number", "ref": [{ "term": "backref" }] },
        "marker": [
          {
            "node": "ref",
            "args": { "role": "fn-marker", "attach": "prev", "target": { "slot": "alias" }, "label": { "slot": "marker-alias" } }
          }
        ]
      }
    },
    "term": {
      "select": [{ "node": "term" }],
      "labels": { "arg": "name" },
      "title": { "arg": "name" },
      "table": "glossary",
      "sites": [
        {
          "where": "replace",
          "template": [
            {
              "node": "group",
              "style": "site",
              "args": { "role": "term", "label": { "slot": "label" } },
              "kids": [
                {
                  "node": "para",
                  "style": "site",
                  "kids": [
                    { "node": "styled", "args": { "role": "term-name" }, "kids": [{ "slot": "title" }] },
                    { "when": "inline-body", "kids": [{ "term": "term-sep" }, { "slot": "inline-body" }] }
                  ]
                },
                { "slot": "block-body" }
              ]
            }
          ]
        }
      ],
      "ref": [{ "slot": "title" }]
    },
    "bibentry": {
      "select": [{ "node": "entry", "role": "bibentry" }],
      "labels": "none",
      "table": "bib",
      "row-key": "key"
    }
  },
  "collectors": {
    "toc": {
      "query": { "classes": "outline", "nest": "depth" },
      "context": "collector",
      "wrap": [{ "node": "list", "args": { "ordered": false }, "kids": [{ "each": "items" }] }],
      "entry": [
        {
          "node": "item",
          "kids": [
            {
              "node": "para",
              "kids": [
                {
                  "node": "link",
                  "args": { "url": { "anchor": "anchor" } },
                  "kids": [{ "slot": "number" }, " ", { "slot": "title" }]
                }
              ]
            }
          ]
        }
      ]
    },
    "glossary": {
      "query": { "table": "glossary" },
      "context": "collector",
      "wrap": [{ "node": "list", "args": { "ordered": false }, "kids": [{ "each": "items" }] }],
      "entry": [
        {
          "node": "item",
          "kids": [
            {
              "node": "para",
              "kids": [
                { "node": "link", "args": { "url": { "anchor": "anchor" } }, "kids": [{ "slot": "title" }] },
                { "when": "body-text", "kids": [{ "term": "term-sep" }, { "slot": "body-text" }] }
              ]
            }
          ]
        }
      ]
    },
    "notes": {
      "query": { "flow": "notes" },
      "context": "instance",
      "wrap": [
        {
          "node": "group",
          "args": { "role": "notes" },
          "kids": [{ "node": "rule" }, { "node": "list", "args": { "ordered": true }, "kids": [{ "each": "items" }] }]
        }
      ],
      "empty": [{ "node": "group", "args": { "role": "notes" } }],
      "entry": [
        {
          "node": "item",
          "kids": [
            {
              "paras": {
                "anchor": { "slot": "alias" },
                "role": "note-body",
                "tail": [" ", { "node": "ref", "args": { "target": { "slot": "marker-alias" } } }]
              }
            }
          ]
        }
      ]
    },
    "bibliography": {
      "query": { "table": "bib", "cited": "cited" },
      "rows": { "counter": "cite", "anchor": { "prefix": "bib-", "body": "key" } },
      "context": "row",
      "cite": [
        "[",
        {
          "each": "keys",
          "sep": [{ "term": "ref-sep" }],
          "kids": [
            {
              "when": "row",
              "kids": [{ "node": "link", "args": { "url": { "anchor": "anchor" } }, "kids": [{ "slot": "ordinal" }] }],
              "else": [{ "term": "unresolved" }]
            }
          ]
        },
        { "when": "extra", "kids": [{ "term": "ref-sep" }, { "slot": "extra" }] },
        "]"
      ],
      "compress": true,
      "wrap": [{ "node": "group", "style": "site", "args": { "role": "bibliography" }, "kids": [{ "node": "rule" }, { "each": "items" }] }],
      "empty": [{ "node": "group", "style": "site", "args": { "role": "bibliography" } }],
      "entry": [
        {
          "node": "para",
          "style": "site",
          "args": { "label": { "slot": "anchor" } },
          "kids": ["[", { "slot": "ordinal" }, "] ", { "slot": "body" }]
        }
      ]
    }
  }
}
